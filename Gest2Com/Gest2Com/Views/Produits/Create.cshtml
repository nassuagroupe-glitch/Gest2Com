@model Gest2Com.Models.Produit
@{
    ViewData["Title"] = "Nouveau produit";
    Layout = "_Layout";
}

<h1>Nouveau produit</h1>

<form method="post" asp-action="Create" enctype="multipart/form-data" class="formulaire">
    @Html.AntiForgeryToken()

    <label>Nom</label>
    <input asp-for="Nom" required />

    <label>Référence</label>
    <input asp-for="Reference" />

    <label>Catégorie</label>
    <select asp-for="Categorie">
        <option value="">-- Sélectionner --</option>
        <option value="Ordinateur Portable">Ordinateur Portable</option>
        <option value="Ordinateur Bureau">Ordinateur Bureau</option>
        <option value="Imprimante">Imprimante</option>
        <option value="Écran">Écran</option>
        <option value="Clavier">Clavier</option>
        <option value="Souris">Souris</option>
        <option value="Téléphone &amp; Tablette">Téléphone &amp; Tablette</option>
        <option value="Réseaux">Réseaux</option>
        <option value="Chargeur">Chargeur</option>
        <option value="Batterie">Batterie</option>
    </select>

    <label>Prix d'achat</label>
    <input asp-for="PrixAchat" type="number" step="0.01" />

    <label>Prix de vente</label>
    <input asp-for="PrixVente" type="number" step="0.01" required />

    <label>Quantité en stock</label>
    <input asp-for="QuantiteStock" type="number" />

    <label>Seuil d'alerte</label>
    <input asp-for="SeuilAlerte" type="number" />

    <label>Image du produit</label>
    <input type="file" name="image" accept="image/*" />

    <button type="submit">Créer le produit</button>
</form>
