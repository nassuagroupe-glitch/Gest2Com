@model Gest2Com.Models.Produit
@{
    ViewData["Title"] = "Modifier le produit";
    Layout = "_Layout";
}

<h1>Modifier @Model.Nom</h1>

<form method="post" asp-action="Edit" asp-route-id="@Model.Id" enctype="multipart/form-data" class="formulaire">
    @Html.AntiForgeryToken()
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="ImageNomFichier" />

    <label>Nom</label>
    <input asp-for="Nom" required />

    <label>Référence</label>
    <input asp-for="Reference" />

    <label>Catégorie</label>
    <input asp-for="Categorie" />

    <label>Prix d'achat</label>
    <input asp-for="PrixAchat" type="number" step="0.01" />

    <label>Prix de vente</label>
    <input asp-for="PrixVente" type="number" step="0.01" required />

    <label>Quantité en stock</label>
    <input asp-for="QuantiteStock" type="number" />

    <label>Seuil d'alerte</label>
    <input asp-for="SeuilAlerte" type="number" />

    <label>Image du produit</label>
    @if (!string.IsNullOrEmpty(Model.ImageNomFichier))
    {
        <img src="/img/produits/@Model.ImageNomFichier" alt="@Model.Nom" style="width:80px; height:80px; object-fit:cover; border-radius:4px; display:block; margin-bottom:8px;" />
    }
    <input type="file" name="image" accept="image/*" />

    <button type="submit">Enregistrer</button>
</form>
